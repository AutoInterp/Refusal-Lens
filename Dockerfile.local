# syntax=docker/dockerfile:1.6
#
# COPY-based fallback Dockerfile.
# Use this when GitHub is unreachable at build time (proxy / firewall) but
# PyPI still is, or when you want to iterate on a host-local repo without
# rebuilding. The host's repo (including submodules) is COPY'd into the
# image as build context, so no git-clone step is performed.
#
# Before building, make sure your host repo has submodules populated:
#   git submodule update --init --recursive
#
# Build:
#   docker build -f Dockerfile.local -t refusal-lens:l15 \
#       --build-arg HTTP_PROXY=http://proxy:port \
#       --build-arg HTTPS_PROXY=http://proxy:port .
#
# Run (interactive, GPU, host-owned outputs for host-side git ops):
#   docker run --rm -it --gpus=all --ipc=host --shm-size=16g \
#       --user "$(id -u):$(id -g)" \
#       -v "$PWD/outputs":/workspace/outputs \
#       -v "$PWD/hf-cache":/workspace/hf-cache \
#       -e HF_TOKEN="$HF_TOKEN" \
#       -e GITHUB_TOKEN="$GITHUB_TOKEN" \
#       -e GIT_USER_NAME="Mahmoud Shabana" \
#       -e GIT_USER_EMAIL="algoversemechinterp@gmail.com" \
#       -e HOME=/tmp \
#       refusal-lens:l15
#
# The --user + HOME=/tmp combination makes every file written into
# /workspace/outputs and /workspace/hf-cache owned by the host UID on the
# host filesystem — so `git add` on the host "just works" without a chown
# step, and without needing sudo to fix root-owned files.

FROM pytorch/pytorch:2.4.1-cuda12.1-cudnn9-devel

ARG HTTP_PROXY=
ARG HTTPS_PROXY=
ARG NO_PROXY=
ARG ALL_PROXY=

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_DEFAULT_TIMEOUT=180 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HOME=/workspace/hf-cache \
    HF_HUB_ENABLE_HF_TRANSFER=1 \
    TOKENIZERS_PARALLELISM=false \
    HTTP_PROXY=${HTTP_PROXY} \
    HTTPS_PROXY=${HTTPS_PROXY} \
    NO_PROXY=${NO_PROXY} \
    ALL_PROXY=${ALL_PROXY} \
    http_proxy=${HTTP_PROXY} \
    https_proxy=${HTTPS_PROXY} \
    no_proxy=${NO_PROXY} \
    all_proxy=${ALL_PROXY}

RUN if [ -n "${HTTP_PROXY}" ]; then \
        printf 'Acquire::http::Proxy "%s";\nAcquire::https::Proxy "%s";\n' \
            "${HTTP_PROXY}" "${HTTPS_PROXY:-$HTTP_PROXY}" \
            > /etc/apt/apt.conf.d/00proxy; \
    fi \
    && apt-get update && apt-get install -y --no-install-recommends \
        git git-lfs curl jq ca-certificates tini openssh-client less vim \
    && git lfs install \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# COPY the repo from build context (host must have submodules initialized).
# The .dockerignore skips data/, outputs/, hf-cache/, *.pt, etc. — keep it
# updated so the build context stays small.
COPY . /workspace/Refusal-Lens

WORKDIR /workspace/Refusal-Lens

RUN pip install --upgrade pip \
    # The PyTorch base image can ship a torchvision that's ABI-incompatible
    # with its own torch (observed: torch 2.11.0 + torchvision 0.19.1+cu121,
    # which breaks `torchvision::nms` registration and cascades into a
    # misleading `Gemma3ForConditionalGeneration` ImportError via
    # transformers.image_utils). Upgrading torchvision without pinning a
    # version lets pip pick the matching release for whatever torch is
    # actually installed. Do this BEFORE installing transformers so the
    # test at the end catches any remaining mismatch.
    && pip install --upgrade torchvision \
    && pip install \
        "transformers==4.57.3" \
        "huggingface_hub==0.36.2" \
        "accelerate" \
        "nnsight==0.6.1" \
        "safetensors" \
        "einops" \
        "matplotlib" \
        "scipy" \
        "pandas" \
        "seaborn" \
        "upsetplot" \
        "hf_transfer" \
        "tqdm" \
        "ipython" \
    && pip install -e vendor/circuit-tracer \
    && python -c "import torch, torchvision; print(f'torch {torch.__version__} / torchvision {torchvision.__version__}')" \
    && python -c "import torchvision; torchvision.ops.nms" \
    && python -c "from transformers import AutoModelForCausalLM; print('transformers import OK')" \
    && python -c "from circuit_tracer import attribute; import inspect; \
        assert 'measurement_layer' in inspect.signature(attribute).parameters, \
        'measurement patch missing from vendored circuit-tracer'; \
        print('measurement patch OK')"

ENV PYTHONPATH=/workspace/Refusal-Lens/scripts/pipeline:/workspace/Refusal-Lens/src

VOLUME ["/workspace/outputs", "/workspace/hf-cache"]

COPY <<'EOF' /usr/local/bin/entrypoint.sh
#!/usr/bin/env bash
# NOTE: no `set -e`. When the container runs with --user <non-root-uid>, some
# of the optional git-config steps below will fail (HOME unwritable, or
# /workspace/Refusal-Lens/.git owned by root at build time). Those are
# best-effort setup — a failure shouldn't kill the container before the user
# even gets a prompt.

# When running as --user, HOME may be /root (unwritable) or unset. Redirect
# to a writable location so `git config --global` has somewhere to write.
if [ -z "${HOME:-}" ] || [ ! -w "${HOME}" ]; then
    export HOME=/tmp
fi

if [ -n "${GIT_USER_NAME:-}" ]; then
    git config --global user.name "${GIT_USER_NAME}" 2>/dev/null || \
        echo "  (entrypoint) note: could not set git user.name; do `git config` manually if needed"
fi
if [ -n "${GIT_USER_EMAIL:-}" ]; then
    git config --global user.email "${GIT_USER_EMAIL}" 2>/dev/null || true
fi
if [ -n "${GITHUB_TOKEN:-}" ] && [ -d /workspace/Refusal-Lens/.git ]; then
    cd /workspace/Refusal-Lens
    # Only attempt to rewrite origin if we can write .git/config. Non-root
    # containers can't (image was built as root), but that's fine — the
    # expected workflow for non-root mode is to do git ops on the host.
    if [ -w .git/config ]; then
        git remote set-url origin \
            "https://oauth2:${GITHUB_TOKEN}@github.com/AutoInterp/Refusal-Lens.git" \
            2>/dev/null || true
    fi
    cd /workspace
fi

# Tell the user which UID we're running as — removes confusion when they see
# files on the host owned by something unexpected.
echo "--- runtime ---"
echo "uid=$(id -u)  gid=$(id -g)  HOME=${HOME}"
if command -v nvidia-smi >/dev/null 2>&1; then
    nvidia-smi --query-gpu=name,memory.total,driver_version --format=csv 2>/dev/null || true
fi
echo "---------------"

exec "$@"
EOF
RUN chmod +x /usr/local/bin/entrypoint.sh \
    # Make /workspace world-writable at the TOP level so a non-root runtime
    # user can create subdirectories (e.g. if outputs mount is missing
    # permissions, they fall back to /workspace/tmp). The bind-mounted
    # subdirs (/workspace/outputs, /workspace/hf-cache) inherit their
    # permissions from the host mount, unaffected by this.
    && chmod 1777 /workspace

ENTRYPOINT ["tini", "--", "/usr/local/bin/entrypoint.sh"]
CMD ["/bin/bash"]
